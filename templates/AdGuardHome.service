[Unit]
Description=AdGuard Home
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/AdGuardHome
ExecStart=/opt/AdGuardHome/AdGuardHome -c /opt/AdGuardHome/AdGuardHome.yaml -w /opt/AdGuardHome --no-check-update
Restart=on-failure
RestartSec=10

# Hardening (safe set): /opt stays writable under ProtectSystem=full, so the
# binary can still write its own config/logs/querylog.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
